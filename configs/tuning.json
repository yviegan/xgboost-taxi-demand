{
  "hourly_input": "data/processed/hourly_demand.parquet",
  "output_dir": "reports/tuning",
  "validation_days": 7,
  "test_days": 7,
  "random_state": 42,
  "n_random_candidates": 16,
  "development_folds": [
    {"name": "dev-2025-03-10", "test_start": "2025-03-10"},
    {"name": "dev-2025-03-24", "test_start": "2025-03-24"},
    {"name": "dev-2025-04-07", "test_start": "2025-04-07"}
  ],
  "holdout_folds": [
    {"name": "holdout-2025-05-25", "test_start": "2025-05-25"},
    {"name": "holdout-2025-06-10", "test_start": "2025-06-10"},
    {"name": "holdout-2025-06-24", "test_start": "2025-06-24"}
  ],
  "lags": [1, 2, 3, 24, 168],
  "rolling_windows": [3, 6, 24, 168],
  "fixed_model_params": {
    "objective": "count:poisson",
    "n_estimators": 2000,
    "tree_method": "hist",
    "random_state": 42,
    "n_jobs": -1,
    "early_stopping_rounds": 100
  },
  "manual_params": {
    "learning_rate": 0.05,
    "max_depth": 8,
    "min_child_weight": 10,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "reg_lambda": 5.0,
    "reg_alpha": 0.0
  },
  "parameter_space": {
    "learning_rate": [0.03, 0.05, 0.08],
    "max_depth": [4, 6, 8, 10],
    "min_child_weight": [5, 10, 20, 40],
    "subsample": [0.7, 0.85, 1.0],
    "colsample_bytree": [0.7, 0.85, 1.0],
    "reg_lambda": [1.0, 5.0, 10.0, 20.0],
    "reg_alpha": [0.0, 0.1, 1.0]
  }
}
