{
  "hourly_input": "data/processed/hourly_demand.parquet",
  "output_dir": "reports/rolling",
  "validation_days": 7,
  "test_days": 7,
  "folds": [
    {"name": "2025-04-end", "test_start": "2025-04-24"},
    {"name": "2025-05-end", "test_start": "2025-05-25"},
    {"name": "2025-06-mid", "test_start": "2025-06-10"},
    {"name": "2025-06-end", "test_start": "2025-06-24"}
  ],
  "lags": [1, 2, 3, 24, 168],
  "rolling_windows": [3, 6, 24, 168],
  "peak_hours": [7, 8, 9, 16, 17, 18, 19],
  "top_zone_count": 20,
  "model": {
    "objective": "count:poisson",
    "n_estimators": 1000,
    "learning_rate": 0.05,
    "max_depth": 8,
    "min_child_weight": 10,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "reg_lambda": 5.0,
    "tree_method": "hist",
    "random_state": 42,
    "n_jobs": -1
  }
}
